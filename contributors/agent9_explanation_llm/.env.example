# Which provider is primary. "mock" needs no keys and no network --
# use it to build/test/demo the pipeline before you have API keys.
LLM_PROVIDER=mock

# --- Gemini (recommended primary) ---
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (recommended fallback) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generation settings -- kept low: this agent extracts/summarizes,
# it doesn't need creativity.
LLM_TEMPERATURE=0.2
LLM_STRICT_RETRY_TEMPERATURE=0.0
LLM_TIMEOUT_S=12
